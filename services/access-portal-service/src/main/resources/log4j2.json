{
  "Configuration": {
    "status": "TRACE",
    "name": "AccessPortalServiceConfig",
    "properties": {
      "property": [
        {
          "name": "app-name",
          "value": "access-portal-service"
        }
      ]
    },
    "Appenders": {
      "CONSOLE": {
        "name": "CONSOLE",
        "target": "SYSTEM_OUT",
        "PatternLayout": {
          "pattern": "%highlight{%d{HH:mm:ss.SSS} [%15.15t] %-5level %c{1} - %msg%n}{FATAL=red blink, ERROR=red, WARN=yellow bold, INFO=green, DEBUG=cyan, TRACE=blue}"
        }
      },
      "UnifiedHttpAppender": {
        "type": "UnifiedHttpAppender",
        "name": "UnifiedHttpAppender",
        "endpoint": "${env:OPENSEARCH_URL:-http://localhost:9200}/main-logs/_doc",
        "username": "${env:OPENSEARCH_USERNAME:-admin}",
        "password": "${env:OPENSEARCH_PASSWORD:-!Admin123456}",
        "JsonTemplateLayout": {
          "eventTemplateUri": "classpath:log-template.json"
        }
      }
    },
    "Loggers": {
      "Root": {
        "level": "INFO",
        "AppenderRef": [
          {
            "ref": "CONSOLE"
          },
          {
            "ref": "UnifiedHttpAppender"
          }
        ]
      },
      "Logger": [
        {
          "name": "com.aidentx.access_portal_service",
          "level": "DEBUG",
          "additivity": false,
          "AppenderRef": [
            {
              "ref": "CONSOLE"
            },
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.springframework.security",
          "level": "WARN",
          "additivity": false,
          "AppenderRef": [
            {
              "ref": "CONSOLE"
            },
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.hibernate",
          "level": "WARN",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.hibernate.SQL",
          "level": "OFF",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.hibernate.type.descriptor.sql",
          "level": "OFF",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.hibernate.type.descriptor.sql.BasicBinder",
          "level": "OFF",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.springframework.web",
          "level": "INFO",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "HttpURLConnection",
          "level": "WARN",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "sun.net.www.protocol.http.HttpURLConnection",
          "level": "WARN",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.springframework.security.saml2",
          "level": "OFF",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        },
        {
          "name": "org.springframework.security.oauth2",
          "level": "WARN",
          "AppenderRef": [
            {
              "ref": "UnifiedHttpAppender"
            }
          ]
        }
      ]
    }
  }
}