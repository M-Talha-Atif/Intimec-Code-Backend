<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <groupId>com.aidentx.dal</groupId>
	<artifactId>connector-framework</artifactId>
	<version>1.0.0</version>
	<name>connector-framework</name>
	<description>Handles dynamic connector loading, pooling, and runtime interaction via the ConnId framework.</description>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- Your organization's Unified Logging Framework -->
		<dependency>
            <groupId>com.aidentx.logging</groupId>
			<artifactId>unified-logging-starter</artifactId>
			<version>1.0.0</version>
		</dependency>

		<!-- Spring Context for @Service, @Value, @Scheduled annotations -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
			<version>6.2.9</version>
		</dependency>

		<!-- ConnId framework dependencies -->
		<dependency>
			<groupId>net.tirasa.connid</groupId>
			<artifactId>connector-framework</artifactId>
			<version>1.5.2.0</version>
		</dependency>
		<dependency>
			<groupId>net.tirasa.connid</groupId>
			<artifactId>connector-framework-internal</artifactId>
			<version>1.5.1.0</version>
		</dependency>
	</dependencies>

</project>