            <version>21.03.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aidentx.logging</groupId>
            <artifactId>unified-logging-starter</artifactId>
        </dependency>
    </dependencies>

</project>