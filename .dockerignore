# .dockerignore - Optimize Docker build context

# Version control
.git
.gitignore
.gitattributes

# IDE files
.idea
.vscode
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build outputs (will be built inside Docker)
target/
*/target/
build/
*/build/
out/
*/out/

# Maven wrapper (if not needed)
.mvn/
mvnw
mvnw.cmd

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log
logs/

# Runtime data
*.pid
*.seed
*.pid.lock

# Docker related (avoid nested Docker)
Dockerfile*
.dockerignore
docker-compose*.yml

# Documentation
README.md
*.md
docs/

# Test files (if not needed for build)
src/test/
*/src/test/

# IDE specific Maven settings (let Docker create its own)
.m2/

# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile
.travis.yml
azure-pipelines.yml

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Coverage reports
coverage/
*.lcov
.nyc_output

# Environment files
.env
.env.local
.env.*.local

# Application specific
application-local.yml
application-local.properties