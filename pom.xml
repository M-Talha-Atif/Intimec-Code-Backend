<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- This makes the root POM also inherit from Spring Boot's parent -->
    <!-- This is crucial for managing dependency versions across all modules -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.aidentx</groupId>
    <artifactId>backend-aggregator</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Backend Aggregator POM</name>
    <description>Parent and Aggregator for all backend microservices and shared libraries</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <aidentx.shared.version>1.0.0</aidentx.shared.version>
        <auditlog-dto.version>1.0.0</auditlog-dto.version>
        <unified-logging.version>1.0.0</unified-logging.version>
        <common-protos.version>1.0.0</common-protos.version>
        <dgraph-client.version>1.0.0</dgraph-client.version>
    </properties>

    <modules>
        <module>services</module>
        <module>shared</module>
    </modules>

    <!--
      This <dependencyManagement> block acts as a Bill of Materials (BOM).
      It defines a list of all shared libraries and their official versions.
      All microservice sub-modules should depend on this POM to ensure they
      use consistent versions of shared dependencies.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Your Custom Shared Libraries -->
            <dependency>
                <groupId>com.aidentx</groupId>
                <artifactId>dgraph-client</artifactId>
                <version>${dgraph-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aidentx.dal</groupId>
                <artifactId>common-protos</artifactId>
                <version>${common-protos.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aidentx.auditlogdto</groupId>
                <artifactId>auditlog-dto</artifactId>
                <version>${auditlog-dto.version}</version>
            </dependency>
            <dependency>
                <groupId>com.aidentx.logging</groupId>
                <artifactId>unified-logging-starter</artifactId>
                <version>${unified-logging.version}</version>
            </dependency>

            <!-- Key Third-Party Libraries (Example) -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-client-spring-boot-starter</artifactId>
                <version>3.1.0.RELEASE</version>
            </dependency>
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-server-spring-boot-starter</artifactId>
                <version>3.1.0.RELEASE</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <plugins>
            <!-- Maven Compiler Plugin with MapStruct processor -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>